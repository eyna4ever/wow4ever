PUBLIC_URL='http://localhost:8000'
DATABASE='instance/community.sqlite3'
DISCORD_CLIENT_ID=''
DISCORD_CLIENT_SECRET=''
CONTROLLER_NAME=''
PRIVACY_CONTACT=''
