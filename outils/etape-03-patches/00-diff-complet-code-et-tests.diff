diff --git a/pipeline/tests/v21-lot1.test.mjs b/pipeline/tests/v21-lot1.test.mjs
new file mode 100644
index 0000000..9f8868d
--- /dev/null
+++ b/pipeline/tests/v21-lot1.test.mjs
@@ -0,0 +1,110 @@
+// V2.1 étape 03 — lot 1 (isolated test tree): referential integrity, sources/status rules, idempotence, Android HTML
+// and basic accessibility checks. Skips itself when lot 1 is not present (production dataset).
+import {test, afterEach} from 'node:test';
+import assert from 'node:assert/strict';
+import {readFile, readdir} from 'node:fs/promises';
+import {existsSync} from 'node:fs';
+import {join, dirname} from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {auditDataset, merge, validate} from '../lib/documentary.mjs';
+import {selectPublicEntries} from '../lib/public-catalog.mjs';
+import {classifySource, entryVerification} from '../lib/source-policy.mjs';
+import {setCategoryNames, setVisualLinks} from '../lib/pages.mjs';
+import {setV2Catalog, renderEntry, renderCategory} from '../lib/v2/render.mjs';
+import {entryPath} from '../lib/articles.mjs';
+import {LOT1_IDS, lot1Published} from './lot1-ids.mjs';
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..');
+const records = JSON.parse(await readFile(join(root, 'runtime/entries.json'), 'utf8'));
+const batchPath = join(root, '../../lot1/lot1.entries.json');
+const present = lot1Published(records) === LOT1_IDS.length && existsSync(batchPath);
+const skip = !present && 'lot 1 not published in this dataset';
+const categories = JSON.parse(await readFile(join(root, 'public/wiki/catalog.json'), 'utf8')).categories;
+const lot = records.filter(e => LOT1_IDS.includes(e.id));
+afterEach(() => setVisualLinks([]));
+
+test('lot 1 — referential integrity: dataset audit clean, every relation and block source resolves', {skip}, () => {
+  const audit = auditDataset(records);
+  assert.deepEqual(audit.errors, []);
+  const published = new Set(records.filter(e => e.status === 'published').map(e => e.id));
+  for (const entry of lot) {
+    assert.deepEqual(validate(entry), [], entry.id);
+    for (const id of entry.relations) assert.ok(published.has(id), `${entry.id} → ${id} must be a published entry`);
+    assert.ok(entry.relations.length >= 1, `${entry.id} is linked`);
+  }
+  const pub = selectPublicEntries(records);
+  for (const id of LOT1_IDS) assert.ok(pub.some(e => e.id === id), `${id} public`);
+  const slugs = pub.flatMap(e => ['fr', 'en'].map(l => e.url[l]));
+  assert.equal(new Set(slugs).size, slugs.length, 'no URL collision');
+});
+
+test('lot 1 — sources and status: official Blizzard only, never third-party, never « à confirmer » needed', {skip}, () => {
+  for (const entry of lot) {
+    assert.ok(entry.sources.length >= 1);
+    for (const s of entry.sources) {
+      assert.equal(classifySource(s.url), 'officiel', `${entry.id}: ${s.url}`);
+      assert.doesNotMatch(s.url, /wiki\.gg|eternadex|wowhead|wago\.tools|wow\.tools/);
+      assert.match(s.license, /Blizzard/);
+      assert.equal(s.accessedAt, '2026-11-09');
+    }
+    assert.equal(entryVerification(entry), 'officiel confirmé');
+    assert.equal(entry.verification, 'officiel confirmé');
+    assert.ok(entry.article.pending.length >= 1, `${entry.id}: says what is not confirmed`);
+    assert.ok(entry.history.some(h => /TEST-ISOLE/.test(h.actor)), `${entry.id}: test-only approval is labelled`);
+    assert.match(entry.review.reviewer, /PAS une validation humaine de Mathieu/);
+  }
+});
+
+test('lot 1 — counted facts match the official articles (65 challenges, 21 perks, 4 rewards, 11 camp items)', {skip}, () => {
+  const by = id => lot.find(e => e.id === id);
+  const rows = by('forever-legacy-challenges').article.sections[0].blocks[0].rows;
+  assert.deepEqual(rows.map(r => Number(r[1].fr)), [27, 18, 12, 2, 3, 3]);
+  assert.equal(rows.reduce((n, r) => n + Number(r[1].fr), 0), 65);
+  const perks = by('forever-legacy-perks').article.sections.map(s => s.blocks[0].rows.length);
+  assert.deepEqual(perks, [7, 7, 7]);
+  assert.equal(by('forever-legacy-rewards').article.sections[0].blocks[0].rows.length, 4);
+  assert.equal(by('forever-camp-features').article.sections[0].blocks[0].rows.length, 11);
+  assert.equal(by('forever-questline-gelkis-magram').article.sections[0].blocks[0].items.length, 16);
+});
+
+test('lot 1 — idempotence: re-importing the batch inserts nothing (7 duplicates, no conflict)', {skip}, async () => {
+  const batch = JSON.parse(await readFile(batchPath, 'utf8'));
+  const {records: after, report} = merge(records, batch, {now: '2026-11-09T12:00:00Z'});
+  assert.deepEqual(report.inserted, []);
+  assert.deepEqual(report.conflicts, []);
+  assert.deepEqual(report.invalid, []);
+  assert.deepEqual(report.quarantined, []);
+  assert.equal(report.duplicates.length, 7);
+  assert.equal(JSON.stringify(after), JSON.stringify(records));
+});
+
+test('lot 1 — Android/accessibility: viewport, lang, noindex, one h1, no heading skip, captioned tables, no inline script/style', {skip}, async () => {
+  const pub = selectPublicEntries(records);
+  setCategoryNames(categories); setVisualLinks(pub); setV2Catalog(pub);
+  const pages = [];
+  for (const lang of ['fr', 'en']) {
+    for (const id of LOT1_IDS) pages.push([id, lang, renderEntry(pub.find(e => e.id === id), lang)]);
+    for (const cat of ['quests', 'professions']) pages.push([cat, lang, renderCategory(cat, lang)]);
+  }
+  for (const [id, lang, html] of pages) {
+    const where = `${id}/${lang}`;
+    assert.match(html, /<meta name="viewport" content="width=device-width,initial-scale=1">/, where);
+    assert.match(html, new RegExp(`<html lang="${lang}"`), where);
+    assert.match(html, /<meta name="robots" content="noindex,nofollow">/, where);
+    assert.match(html, /<title>[^<]{10,}<\/title>/, where);
+    assert.equal((html.match(/<h1[\s>]/g) ?? []).length, 1, `${where}: one h1`);
+    const levels = [...html.matchAll(/<h([1-6])[\s>]/g)].map(m => Number(m[1]));
+    for (let i = 1; i < levels.length; i++) assert.ok(levels[i] <= levels[i - 1] + 1, `${where}: heading skip h${levels[i - 1]}→h${levels[i]}`);
+    assert.doesNotMatch(html, /<script(?![^>]*\bsrc=)[^>]*>/, `${where}: inline script`);
+    assert.doesNotMatch(html, /\sstyle=|<style/, `${where}: inline style`);
+    for (const table of html.match(/<table>[\s\S]*?<\/table>/g) ?? []) {
+      assert.match(table, /<caption>/, where); assert.match(table, /<th scope="col">/, where);
+    }
+    // Android: every table sits in a focusable horizontal-scroll region
+    assert.equal((html.match(/<table>/g) ?? []).length, (html.match(/<div class="table-wrap" role="region" aria-label="[^"]+" tabindex="0"><table>/g) ?? []).length, where);
+    assert.ok(!html.includes('status-pill is-draft">À confirmer<') && !html.includes('status-pill is-draft">Unconfirmed'), `${where}: official lot shows no unconfirmed pill`);
+  }
+  // the built tree carries no sitemap (owner decision: noindex, no sitemap)
+  const top = await readdir(join(root, 'dist-v2')).catch(() => []);
+  assert.ok(!top.some(name => /sitemap/i.test(name)));
+});
diff --git a/pipeline/tests/v21-source-policy.test.mjs b/pipeline/tests/v21-source-policy.test.mjs
new file mode 100644
index 0000000..0768f9c
--- /dev/null
+++ b/pipeline/tests/v21-source-policy.test.mjs
@@ -0,0 +1,149 @@
+// V2.1 étape 03 — regression tests for the source policy (decisions of 09/11/2026):
+// Eternadex/client-extract only => « à confirmer »; wiki.gg refused; official Blizzard still official;
+// mixing official + Eternadex never upgrades the Eternadex-only claims.
+import {test, afterEach} from 'node:test';
+import assert from 'node:assert/strict';
+import {readFile} from 'node:fs/promises';
+import {contentDigest, merge, validate} from '../lib/documentary.mjs';
+import {selectPublicEntries} from '../lib/public-catalog.mjs';
+import {classifySource, entryVerification, applySourcePolicy} from '../lib/source-policy.mjs';
+import {setCategoryNames, setVisualLinks} from '../lib/pages.mjs';
+import {setV2Catalog, renderEntry, renderCategory} from '../lib/v2/render.mjs';
+import {searchIndex} from '../lib/site-chrome.mjs';
+
+const categories = JSON.parse(await readFile(new URL('../public/wiki/catalog.json', import.meta.url), 'utf8')).categories;
+afterEach(() => setVisualLinks([]));
+const GV = 'World of Warcraft: Forever — test politique de sources';
+const PILL = {fr: 'status-pill is-draft">À confirmer<', en: 'status-pill is-draft">Unconfirmed — to be confirmed<'};
+const BZ = (lang, key) => ({key: `${key}-${lang}`, language: lang, publishedAt: '2026-09-23', url: `https://news.blizzard.com/${lang === 'fr' ? 'fr-fr' : 'en-us'}/article/24307383/test`, title: `Blizzard ${lang}`, accessedAt: '2026-11-09', license: 'Droits réservés Blizzard ; synthèse originale.', gameVersion: GV});
+const ETX = {key: 'etx', language: 'en', undated: true, url: 'https://eternadex.com/en/datenbank/', title: 'Eternadex', accessedAt: '2026-11-09', license: 'Aucune licence publiée', gameVersion: GV, verification: 'officiel confirmé'};
+const WIKIGG = {url: 'https://warcraft.wiki.gg/wiki/Quest', title: 'wiki.gg', accessedAt: '2026-11-09', license: 'CC BY-SA', gameVersion: GV};
+
+function base(id, sources, extra = {}) {
+  return {id, title: {fr: `Titre ${id}`, en: `Title ${id}`}, description: {fr: 'Description test.', en: 'Test description.'}, category: 'professions', subcategory: 'test-politique',
+    sources, status: 'draft', updatedAt: '2026-11-09', gameVersion: GV, version: 1, relations: [], history: [{at: '2026-11-09', actor: 'test', note: 'fixture', version: 1}], ...extra};
+}
+function publish(entry) {
+  const e = structuredClone(entry);
+  e.status = 'published'; e.identityConfirmed = true; delete e.importMeta;
+  e.review = {approved: true, reviewer: 'test-fixture', at: '2026-11-09', rightsConfirmed: true, translationsConfirmed: true};
+  e.review.contentDigest = contentDigest(e);
+  return e;
+}
+const render = (dto, lang) => { setCategoryNames(categories); setV2Catalog([dto]); return renderEntry(dto, lang); };
+
+test('policy 1 — Eternadex-only record: accepted only as « à confirmer », shown with the mention, never official', () => {
+  const raw = base('test-eternadex-only', [ETX], {verification: 'officiel confirmé', facts: [{id: 'f1', src: ['etx'], status: 'vérifié en jeu', fr: 'x', en: 'x'}]});
+  assert.equal(classifySource(ETX.url), 'extrait_client');
+  // direct edit claiming official is rejected
+  assert.ok(validate(raw).some(e => /aucune source officielle/.test(e)));
+  assert.ok(validate(raw).some(e => /extrait_client ne peut pas être « officiel confirmé »/.test(e)));
+  // import: inserted as draft but downgraded and reported
+  const {records, report} = merge([], [raw], {now: '2026-11-09T12:00:00Z'});
+  assert.deepEqual(report.inserted, ['test-eternadex-only']);
+  assert.equal(report.downgraded.length, 1);
+  const stored = records[0];
+  assert.equal(stored.verification, 'à confirmer');
+  assert.equal(stored.sources[0].verification, 'à confirmer');
+  assert.equal(stored.facts[0].status, 'à confirmer');
+  assert.deepEqual(validate(stored), []);
+  // published output: DTO + page + listing + search index carry the mention
+  const [dto] = selectPublicEntries([publish(stored)]);
+  assert.equal(dto.verification, 'à confirmer');
+  assert.equal(dto.sources[0].tier, 'extrait_client');
+  const fr = render(dto, 'fr'), en = render(dto, 'en');
+  assert.ok(fr.includes(PILL.fr) && en.includes(PILL.en));
+  assert.match(fr, /0 source officielle \+ 1 source non officielle/);
+  assert.match(fr, /Source non officielle — à confirmer/);
+  assert.match(en, /Non-official source — unconfirmed/);
+  assert.doesNotMatch(fr, />1 source officielle</);
+  assert.doesNotMatch(fr, /officiel confirmé|vérifié en jeu/);
+  assert.match(fr, /Aucune source officielle Blizzard pour cette fiche/);
+  assert.doesNotMatch(fr, /Sources officielles Blizzard Entertainment \(droits réservés\)/);
+  assert.match(en, /No official Blizzard source for this entry/);
+  assert.ok(fr.match(/<section[^>]*id="en-bref"[\s\S]*?<\/section>/)[0].includes(PILL.fr), 'brief paragraph marked');
+  assert.ok(renderCategory('professions', 'fr').includes(PILL.fr));
+  assert.equal(searchIndex({categories, entries: [{...dto, url: dto.url}]}).entries[0].verification, 'à confirmer');
+});
